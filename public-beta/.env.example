# Set an actual domain pointed to the persistent host. No placeholder deploys.
BETA_DOMAIN=
PUBLIC_ORIGIN=
# Include GitHub Pages AND the public faucet origin, comma separated.
ALLOWED_ORIGINS=https://nepnoid.github.io
TURNSTILE_SITE_KEY=
# Hostname of the actual faucet page (without scheme).
TURNSTILE_HOSTNAME=
FAUCET_PAUSED=true
FAUCET_TOKENS=100
FAUCET_GAS=0.001
WALLET_COOLDOWN_HOURS=24
IP_CLAIMS_PER_DAY=3
CLAIMS_PER_DAY=100
# Secrets are files, never inline environment values or committed keys.
# API reads /secrets/faucet.key, /secrets/ip-salt, /secrets/turnstile.secret.
